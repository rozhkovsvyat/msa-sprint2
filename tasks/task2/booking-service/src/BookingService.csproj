<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hotelio.Bookings</RootNamespace>
    <AssemblyName>BookingService</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Контракт задания не меняем: booking.proto из tasks/task2 -->
    <Protobuf Include="..\..\booking.proto" GrpcServices="Server" Link="Protos\booking.proto" />
  </ItemGroup>
  <ItemGroup>
    <!-- Миграции схемы: применяет DbUp по команде migrate (Data/SchemaMigrations.cs) -->
    <EmbeddedResource Include="db\migrations\*.sql" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.16.0" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.84.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
  </ItemGroup>
</Project>
