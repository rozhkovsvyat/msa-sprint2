@startuml
!define RELATIVE_INCLUDE true
!include vendor/c4-plantuml/C4_Container.puml
LAYOUT_TOP_DOWN()
skinparam nodesep 35
skinparam ranksep 75
skinparam defaultFontName Arial
skinparam dpi 130
show stereotype

title
Hotelio To-Be через 2 месяца — контейнеры (C2)
Бронирование вынесено, монолит обслуживает остальное
end title

Person(guest, "Клиент", "Бронирует и открывает\nличный кабинет")
Person(analyst, "Аналитик", "Статистика бронирований")
System_Ext(partners, "Партнёрские каналы", "Клиенты REST API")

System_Boundary(hotelio, "Hotelio") {
  Container(web, "Веб- и мобильные клиенты", "SPA, мобильные приложения", "Поиск, бронирование,\nличный кабинет")

  Boundary(cabinet, "Личный кабинет — GraphQL Federation") {
    Container(gw, "GraphQL-шлюз", "Node.js, Apollo Gateway", "BFF кабинета: собирает суперграф,\nпередаёт userid подграфам")
    Container(bsg, "booking-subgraph", "Node.js, Apollo Subgraph", "Бронирования пользователя;\nACL: только свои")
    Container(hsg, "hotel-subgraph", "Node.js, DataLoader", "Отели по id:\nбатчинг и кеш")
    Container(psg, "promocode-subgraph", "Node.js, Apollo Subgraph", "Скидка и сведения о промокоде;\n@override discountPercent")
  }

  Container(mono, "Монолит Hotelio", "Java 17, Spring Boot", "REST: пользователи, отели,\nпромокоды, отзывы; бронирования\nпроксирует в booking-service")
  ContainerDb(monodb, "БД монолита", "PostgreSQL", "Пользователи, отели, промокоды,\nотзывы; booking — архив\nпосле переключения")

  Container(bs, "booking-service", "C#, .NET 10, gRPC", "Создание и список бронирований,\nцена и скидка, outbox")
  ContainerDb(bsdb, "БД бронирований", "PostgreSQL", "booking, outbox")
  Container(kafka, "Kafka", "Apache Kafka", "Топик booking-events")
  Container(hs, "booking-history-service", "C#, .NET 10", "История и агрегаты\nпо пользователям, отелям, дням")
  ContainerDb(hsdb, "БД истории", "PostgreSQL", "booking_history, статистика")
  Container(mig, "Ops-джоба миграции", "psql-скрипт, разовый запуск", "Перенос бронирований при\nпереключении, обратно — при откате")
}

Rel(guest, web, "Использует")
Rel(web, gw, "Запросы кабинета", "GraphQL/HTTPS")
Rel(web, mono, "Поиск и бронирование", "REST/HTTPS")
Rel(partners, mono, "Бронирования", "REST/HTTPS")

Rel(gw, bsg, "Делегирует поля", "GraphQL")
Rel(gw, hsg, "Делегирует поля", "GraphQL")
Rel(gw, psg, "Делегирует поля", "GraphQL")
Rel(bsg, bs, "ListBookings", "gRPC")
Rel(hsg, mono, "GET /api/hotels/{id}", "REST")
Rel(psg, mono, "GET /api/promos/{code}", "REST")

Rel(mono, bs, "CreateBooking, ListBookings", "gRPC, HTTP/2")
Rel(bs, mono, "Проверки пользователя, отеля,\nотзывов, промокода (ACL)", "REST")
Rel(mono, monodb, "Читает и пишет", "JPA")
Rel(bs, bsdb, "Бронирование и outbox\nв одной транзакции", "SQL")
Rel(bs, kafka, "Публикует BookingCreated", "Kafka")
Rel(hs, kafka, "Читает booking-events,\nсвоя группа", "Kafka")
Rel(hs, hsdb, "Пишет историю идемпотентно", "SQL")
Rel(analyst, hsdb, "Читает статистику", "SQL, только чтение")
Rel(mig, monodb, "Читает / дописывает booking", "SQL")
Rel(mig, bsdb, "Пишет / читает booking", "SQL")
@enduml
