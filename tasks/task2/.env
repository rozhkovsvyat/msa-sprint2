# Прокси монолита: booking-service — бронирования идут в новый сервис, false — в модуль монолита.
# Для учений и отката перекрывается переменной окружения: BOOKING_SERVICE_EXTERNAL_HOST=false docker compose up -d monolith
BOOKING_SERVICE_EXTERNAL_HOST=booking-service

# Токен служебного списка бронирований (booking.admin.BookingAdminService). На стенде значение
# фиксированное, как пароли БД; в бою приходит из хранилища секретов и своё для каждого окружения.
BOOKING_ADMIN_TOKEN=stand-admin-token
